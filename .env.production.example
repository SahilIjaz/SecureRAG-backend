# Production environment for docker-compose.yml. Copy to .env on the server
# and fill in the values. Never commit the real file.
#
#   cp .env.production.example .env && nano .env

# ── Where the API is served (used by Caddy for HTTPS) ──────────────────────
# A hostname whose DNS A record points at this VM. Free options:
#   - your own domain:  api.example.com
#   - DuckDNS:          nexus-api.duckdns.org   (https://www.duckdns.org)
DOMAIN=api.example.com
# Let's Encrypt expiry notices go here (optional but recommended).
ACME_EMAIL=you@example.com

# ── Core ───────────────────────────────────────────────────────────────────
# Neon connection string with the asyncpg driver and SSL:
#   postgresql+asyncpg://USER:PASSWORD@HOST/DB?ssl=require
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxxx.region.aws.neon.tech/neondb?ssl=require
# openssl rand -hex 48
SECRET_KEY=replace_with_a_long_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_DAYS=7
# Keep False in production: True enables /docs and logs OTP codes.
DEBUG=False
SQL_ECHO=False

# ── Browser origins allowed to call the API ────────────────────────────────
# The deployed dashboard (Vercel/Netlify/Cloudflare Pages URL or your domain).
FRONTEND_URL=https://app.example.com
# Extra origins, comma-separated (e.g. a preview URL). Leave empty if none.
CORS_EXTRA_ORIGINS=

# ── Email (OTP, invites, notifications) ────────────────────────────────────
# Brevo HTTP API is the reliable choice on cloud VMs (many block SMTP:587).
BREVO_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=no-reply@example.com
EMAILS_FROM_NAME=Nexus
OTP_EXPIRE_MINUTES=5

GOOGLE_CLIENT_ID=

# ── Storage / encryption ───────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FILE_ENCRYPTION_KEY=
MAX_UPLOAD_SIZE_MB=50
ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain,text/markdown

# ── Scraping / OCR ─────────────────────────────────────────────────────────
CRAWL4AI_ENABLED=true
CRAWL4AI_TIMEOUT=30
CRAWL4AI_MAX_CONTENT_SIZE_MB=50
SCRAPE_OCR_ENABLED=true
GEMINI_OCR_MODEL=gemini-flash-lite-latest
SCRAPE_OCR_MAX_IMAGES=12

# ── Vector store ───────────────────────────────────────────────────────────
PINECONE_API_KEY=
PINECONE_INDEX_NAME=securerag-documents

# ── Billing (Stripe TEST keys until you go live) ───────────────────────────
STRIPE_SECRET_KEY=sk_test_
# From Stripe Dashboard → Developers → Webhooks → endpoint
#   https://$DOMAIN/api/billing/webhook
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_PRICE_STARTER=price_
STRIPE_PRICE_GROWTH=price_
STRIPE_PRICE_BUSINESS=price_

# ── LLM providers ──────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_ANSWER_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest
# Leave empty if you have no working Anthropic key — the app logs a startup
# error for a dead key and that provider's answers fail.
ANTHROPIC_API_KEY=
ANTHROPIC_ANSWER_MODEL=claude-sonnet-5
LLM_PROVIDER_CHAIN=gemini

# ── Trial / wallet ─────────────────────────────────────────────────────────
TRIAL_MESSAGE_LIMIT=50
TRIAL_DURATION_DAYS=3
WALLET_MARKUP_MULTIPLIER=1.30
WALLET_LOW_BALANCE_ALERT_THRESHOLD_USD=2.0
EXISTING_TENANT_MIGRATION_CREDIT_USD=5.0
LLM_BILLING_MIGRATION_CUTOFF=2026-08-25

# ── Post-quantum hardening (python scripts/generate_pq_keys.py) ───────────
PQ_FILE_ENCRYPTION_ENABLED=false
PQ_KEM_PUBLIC_KEY=
PQ_KEM_PRIVATE_KEY=
PQ_WIDGET_TOKEN_SIGNING_ENABLED=false
PQ_SIG_PUBLIC_KEY=
PQ_SIG_PRIVATE_KEY=

# ── Audit / traceability retention (days) ──────────────────────────────────
AUDIT_ENABLED=true
AUDIT_RETENTION_DAYS=365
TRACE_RETENTION_DAYS=180

# REDIS_URL is set by docker-compose.yml (redis://redis:6379/0); do not set it here.
