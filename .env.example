DATABASE_URL=postgresql+asyncpg://user:password@host/dbname
SECRET_KEY=generate_a_long_random_string_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
DEBUG=True

# Email — tried in this order: Brevo HTTP API (if BREVO_API_KEY is set,
# works on hosts like Render that block outbound SMTP), then SMTP below,
# then just logging the email content. Leave BREVO_API_KEY blank to use
# SMTP for local dev.
BREVO_API_KEY=

# SMTP fallback (Gmail example — use an App Password, not your real password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
EMAILS_FROM_EMAIL=your_email@gmail.com
EMAILS_FROM_NAME=SecureRAG++

GOOGLE_CLIENT_ID=your_google_client_id_here

# OTP expiry in minutes
OTP_EXPIRE_MINUTES=1

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# File Encryption (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FILE_ENCRYPTION_KEY=your_encryption_key_here

# Web scraping with Crawl4AI
CRAWL4AI_ENABLED=true
CRAWL4AI_TIMEOUT=30
CRAWL4AI_MAX_CONTENT_SIZE_MB=50

# File upload settings
MAX_UPLOAD_SIZE_MB=50
ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain,text/markdown

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Pinecone Vector Database (for RAG)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=securerag-documents

# Stripe (billing). Secret key from the Stripe Dashboard > Developers > API keys.
# Webhook secret comes from `stripe listen --forward-to localhost:8000/api/billing/webhook`
# during local dev, or the Dashboard's webhook endpoint config once deployed.
# The three price IDs are printed by `python -m scripts.setup_stripe_products`.
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here
STRIPE_PRICE_STARTER=price_your_starter_id
STRIPE_PRICE_GROWTH=price_your_growth_id
STRIPE_PRICE_BUSINESS=price_your_business_id

# Anthropic API (for embeddings and RAG Q&A)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model chain used by rag_service.answer_question(). Prefer "-latest"
# aliases over dated pinned versions (e.g. gemini-2.5-flash) — Google has
# retired dated free-tier model names before without warning.
GEMINI_ANSWER_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest
