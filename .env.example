DATABASE_URL=postgresql+asyncpg://user:password@host/dbname
SECRET_KEY=generate_a_long_random_string_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
DEBUG=True

# Email (Gmail example — use an App Password, not your real password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
EMAILS_FROM_EMAIL=your_email@gmail.com
EMAILS_FROM_NAME=SecureRAG++

GOOGLE_CLIENT_ID=your_google_client_id_here

# OTP expiry in minutes
OTP_EXPIRE_MINUTES=1

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# File Encryption (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FILE_ENCRYPTION_KEY=your_encryption_key_here

# Web scraping with Crawl4AI
CRAWL4AI_ENABLED=true
CRAWL4AI_TIMEOUT=30
CRAWL4AI_MAX_CONTENT_SIZE_MB=50

# File upload settings
MAX_UPLOAD_SIZE_MB=50
ALLOWED_MIME_TYPES=application/pdf

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Pinecone Vector Database (for RAG)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=securerag-documents

# Anthropic API (for embeddings and RAG Q&A)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
